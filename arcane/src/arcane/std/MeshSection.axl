<?xml version="1.0" ?>

<service name="MeshSection" type="caseoption" type2="subdomain">
  <description>
    Service permettant la création d'un maillage avec une section d'un autre maillage.
  </description>

  <interface name="Arcane::IMeshSection" inherited="true"/>

  <variables>
  </variables>

  <options>
    <simple name="unique-id-service-mesh" type="int32" default="0">
      <description>
        ID unique du maillage de service. Utile si vous devez créer plusieurs instances de ce service pour un maillage.
      </description>
    </simple>
  </options>

</service>
